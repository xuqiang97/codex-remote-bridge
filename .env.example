# codex-remote-bridge local configuration template.
# Copy to .env if the implementation supports repository-local .env loading.
# Never commit real credentials, user IDs, conversation IDs, or personal paths.

BRIDGE_CHANNEL=dingtalk
BRIDGE_DEVICE=My-Computer

# DingTalk internal app / bot credentials.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# Comma-separated stable DingTalk user IDs allowed to control this bridge.
# V1 should fail startup if this is empty.
DINGTALK_ALLOWED_USER_IDS=

# Optional comma-separated conversation IDs.
# Keep group chat disabled by default. If group support is later enabled,
# require both sender and conversation allowlists.
DINGTALK_ALLOWED_CONVERSATION_IDS=

# Local Codex executable. Use an absolute path if GUI/background PATH differs.
CODEX_COMMAND=codex

# Optional explicit Codex home. Leave blank to inherit normal Codex behavior.
CODEX_HOME=

# Required list of project roots the remote bridge may expose/control.
# Implementation should document the delimiter/escaping used on each OS.
# Examples only; replace locally.
CODEX_ALLOWED_ROOTS=

# Conservative remote execution defaults.
CODEX_REMOTE_SANDBOX=workspaceWrite
CODEX_REMOTE_APPROVAL_POLICY=never

# Local state only; do not sync this database.
BRIDGE_STATE_PATH=.data/bridge.db

# Input/output safety limits.
BRIDGE_MAX_INPUT_CHARS=4000
BRIDGE_MAX_OUTPUT_CHARS=3000

# Operational logging only. Full prompts/outputs should not be logged by default.
BRIDGE_LOG_LEVEL=INFO
